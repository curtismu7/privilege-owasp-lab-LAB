# Optional. Everything has a safe default; Mock needs no tenant and no credentials.
# PORT must be 7811 (this app's one allocated port).
PORT=7811
# POWASP_BIND=127.0.0.1   # loopback only unless you set this on purpose
# Start mode. Empty (the default) = Real when the Real settings are usable, else Mock.
# MODE=
#
# Real mode (owner-run). On the HOST the lab reads these four from ~/Development/.env (or the file STANDALONE_ENV names),
# never from this repo. In DOCKER, export them in your shell (or put them in an .env beside docker-compose.yml, which is
# git-ignored) and compose passes them through. Never commit a value.
# PINGONE_ENVIRONMENT_ID=
# PINGONE_REGION=NA        # NA, EU, CA, AP (or ASIA), AU, SG
# PINGONE_CLIENT_ID=
# PINGONE_CLIENT_SECRET=
